{
  "name": "@mpesa-sdk/core",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript SDK engine for the Safaricom M-Pesa Daraja API (Node >=20 native fetch + node:crypto).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthrodjear/mpesa-sdk.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
