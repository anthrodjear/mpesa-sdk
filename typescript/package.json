{
  "name": "@mpesa-sdk/core",
  "version": "0.7.1",
  "description": "Zero-dependency TypeScript SDK engine for the Safaricom M-Pesa Daraja API (Node >=20 native fetch + node:crypto).",
  "keywords": [
    "mpesa",
    "daraja",
    "safaricom",
    "mpesa-api",
    "mobile-money",
    "payments",
    "kenya",
    "stk-push",
    "b2c",
    "c2b",
    "typescript",
    "sdk"
  ],
  "license": "MIT",
  "author": "anthrodjear",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/anthrodjear/mpesa-sdk/tree/main/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthrodjear/mpesa-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/anthrodjear/mpesa-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
